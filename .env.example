# ID del collar T60: los 2 bytes tras el 0x30 de la trama (sale de una captura con collar_sub.py decode).
# Copiá este archivo a .env (no se versiona) y poné el de tu collar.
T60_ID=0x1234
# Passkey de 6 dígitos compartido con el control remoto BLE (sin teclado): va en su firmware (ESP_IO_CAP_IN) y solo se
# usa en la ventana de emparejamiento del remoto. Elegí uno propio.
BLE_REMOTE_PIN=123456
