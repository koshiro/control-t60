# ID del collar T60: los 2 bytes tras el 0x30 de la trama (sale de una captura con collar_sub.py decode).
# Copiá este archivo a .env (no se versiona) y poné el de tu collar.
T60_ID=0x1234
# PIN de 6 dígitos del botón remoto BLE (el Mac/celular lo pide al emparejar). Elegí uno propio.
BLE_PIN=123456
